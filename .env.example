APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_MAX_UPLOAD_SIZE_KB=5120
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Default is "log" so a fresh clone works with zero external dependencies.
# For local development, Mailpit (bundled with Herd Lite, auto-started by
# `composer run dev`) catches real outgoing mail at http://127.0.0.1:8025 —
# switch MAIL_MAILER to "smtp" and MAIL_PORT to 1025 to use it.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# DB + file backups (Store Settings > Backups). One-time setup per
# deployment: create a Google Cloud service account, enable the Drive
# API, download its JSON key, then share the destination Drive folder
# with the service account's own email (Editor access) — see
# docs/infrastructure-deployment.md §2.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
# Encrypts the backup zip. Strongly recommended — the DB dump contains
# customer PII (names, phone numbers, addresses, order history).
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

PRODUCT_MAX_IMAGES=5
PRODUCT_MAX_VARIANTS=10

# Which provider is used for new checkouts/SMS sends before a Super Admin
# has ever saved Store Settings — after that first save, the DB-backed
# choice in Store Settings takes over and these are only the fallback.
PAYMENT_PROVIDER=paystack
SMS_PROVIDER=moolre

MOOLRE_API_KEY=
MOOLRE_WEBHOOK_SECRET=
MOOLRE_SENDER_ID=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

GIANTSMS_TOKEN=
GIANTSMS_SENDER_ID=

# Hard cap on how many customers a single admin-composed SMS broadcast can
# reach — every SMS costs real money, so this bounds a single mistake.
SMS_BROADCAST_MAX_RECIPIENTS=500

# Telescope defaults to local/staging only (off automatically when
# APP_ENV=production) — set explicitly here to override. Pulse defaults to
# on in every environment, including production, per CLAUDE.md §17.
# TELESCOPE_ENABLED=true
# PULSE_ENABLED=true
